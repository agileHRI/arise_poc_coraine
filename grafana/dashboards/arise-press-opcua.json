  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Press 1 - Temperature (alert above 103)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "coraine-history-sql-arise"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "coraine-history-sql-arise"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  a.modified_at AS time,\n  replace(a.attr_name, 'https://uri.etsi.org/ngsi-ld/default-context/', '') AS metric,\n  a.v_number AS value\nFROM troe_attrs a\nWHERE a.entity_id = 'urn:ngsi-ld:Machine:press-1'\n  AND a.attr_name = 'https://uri.etsi.org/ngsi-ld/default-context/temperature'\n  AND $__timeFilter(a.modified_at)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 103
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },

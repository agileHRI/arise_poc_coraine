    {
      "id": 3,
      "type": "timeseries",
      "title": "Turtle $turtle - Linear velocity command",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "coraine-history-sql"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "coraine-history-sql"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  a.modified_at AS time,\n  (a.v_compound->>'x')::real AS \"linear x\"\nFROM troe_attrs a\nWHERE a.entity_id = 'urn:ngsi-ld:Turtle:$turtle'\n  AND a.attr_name = 'https://uri.etsi.org/ngsi-ld/default-context/linearCommand'\n  AND $__timeFilter(a.modified_at)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}

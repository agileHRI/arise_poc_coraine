  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Turtle $turtle - Position (x, y)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "coraine-history-sql"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "coraine-history-sql"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  a.modified_at AS time,\n  replace(a.attr_name, 'https://uri.etsi.org/ngsi-ld/default-context/', '') AS metric,\n  a.v_number AS value\nFROM troe_attrs a\nWHERE a.entity_id = 'urn:ngsi-ld:Turtle:$turtle'\n  AND a.attr_name IN ('https://uri.etsi.org/ngsi-ld/default-context/x', 'https://uri.etsi.org/ngsi-ld/default-context/y')\n  AND $__timeFilter(a.modified_at)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
